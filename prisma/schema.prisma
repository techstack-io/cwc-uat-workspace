
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id             String   @id @default(uuid())
  workspaceId    String
  createdBy      String
  title          String
  description    String   @default("")
  expectedResult String   @default("")
  acceptanceCriteria String @default("")
  checklistProgress String @default("[]")
  area           String   @default("Content & Forms")
  priority       String   @default("Medium")
  status         String   @default("To do")
  assignee       String   @default("")
  dueDate        String   @default("")
  jiraKey        String   @default("")
  platform       String   @default("")
  browser        String   @default("")
  reviewerEmail  String   @default("dan.collins@clarkwire.com")
  approvalStatus String   @default("Pending Approval")
  reviewedBy     String   @default("")
  reviewedAt     DateTime?
  reviewComment  String   @default("")
  rootCause      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
  @@index([createdBy])
  @@index([status])
  @@index([reviewerEmail])
  @@index([approvalStatus])
}
